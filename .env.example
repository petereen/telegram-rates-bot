# Telegram Bot
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_BOT_USERNAME=your_bot_username
TELEGRAM_APP_SHORT_NAME=rates
# Created in BotFather for Telegram OIDC web login
TELEGRAM_OIDC_CLIENT_ID=your-oidc-client-id
TELEGRAM_OIDC_CLIENT_SECRET=your-oidc-client-secret

# Supabase (backend key must be able to write to the branding Storage bucket)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-key
# Optional separate service-role key for Storage uploads/deletes. If omitted,
# SUPABASE_KEY must itself be a storage-capable backend key.
SUPABASE_STORAGE_KEY=your-supabase-service-role-key

# Cache TTL in seconds (default 300 = 5 min)
CACHE_TTL=300

# Public HTTPS origin serving the FastAPI app and built React frontend
APP_BASE_URL=https://rates.example.com
# Generate with: openssl rand -hex 32
SESSION_SECRET=replace-with-a-random-secret
SESSION_COOKIE_SECURE=true
# Maximum accepted Telegram Mini App initData age in seconds (24 hours)
AUTH_MAX_AGE=86400

# Self-hosted https://github.com/btseee/mongolian-bank-exchange-rate API
MONGOLIAN_BANK_API_URL=https://rates-api.example.com
